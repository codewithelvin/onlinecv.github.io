{
  "name": "onlinecv",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Browser-only, ATS-friendly resume/CV builder. No backend, all data in IndexedDB.",
  "license": "MIT",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "postinstall": "patch-package",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@react-pdf/renderer": "^3.4.5",
    "antd": "^5.22.5",
    "dayjs": "^1.11.13",
    "i18next": "^23.16.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^5.4.1",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^15.2.0",
    "react-icons": "^5.4.0",
    "react-pdf-html": "^2.0.2",
    "schema-dts": "^1.1.5",
    "yup": "^1.6.1",
    "zustand": "^5.0.2"
  },
  "overrides": {
    "vite": "$vite",
    "brace-expansion": "5.0.8",
    "minimatch": "10.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "patch-package": "^8.0.1",
    "prettier": "3.9.6",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.2.6"
  }
}
